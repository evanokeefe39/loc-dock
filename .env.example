# Path to your git repositories directory
LOCDOCK_REPOS_DIR=~/repos

# Path to Claude Code data directory (default: ~/.claude)
LOCDOCK_CLAUDE_DIR=~/.claude

# IANA timezone for day boundary (default: Europe/Berlin)
LOCDOCK_TIMEZONE=America/New_York

# Hour when "today" starts (24h format, default: 7)
LOCDOCK_DAY_START_HOUR=7

# Day the week starts on (0=Monday, 6=Sunday, default: 0)
LOCDOCK_WEEK_START_DAY=0
